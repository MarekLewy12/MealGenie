# --- Serwer ---
PORT=3000

# --- Autoryzacja ---
JWT_SECRET=

# --- Baza danych ---
# Lokalnie:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mealgenie?schema=public
# Docker Compose (produkcja):
# DATABASE_URL=postgresql://mealgenie:<password>@db:5432/mealgenie?schema=public

# --- Klucze API ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1
TOGETHER_API_KEY=

# --- Guest mode ---
GUEST_RATE_LIMIT_SALT=
GUEST_IMAGE_TTL_MS=

# --- MealGenie Agent ---
MEALGENIE_AGENT_ENABLED=false
MEALGENIE_AGENT_MODEL=gpt-5.4-mini
MEALGENIE_AGENT_REASONING_EFFORT=low
MEALGENIE_AGENT_TEXT_VERBOSITY=low
MEALGENIE_AGENT_OPENAI_STORE=false
MEALGENIE_AGENT_USE_AGENTS_SDK=false
MEALGENIE_AGENT_TIMEOUT_MS=30000
MEALGENIE_AGENT_DEBUG_ERRORS=false
